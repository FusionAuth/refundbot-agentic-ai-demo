# InFusion Agent environment configuration.
# Copy this file to .env.local and fill in the values. Placeholder values are
# enough to compile / type-check / `next build` and to run the app in Scripted
# Agent mode; real values are only needed to actually sign in against a running
# FusionAuth instance and to exercise the MCP tool calls end to end.

# --- FusionAuth instance -----------------------------------------------------

# Base URL of your FusionAuth instance (no trailing slash needed).
FUSIONAUTH_URL=http://localhost:9011

# The main "InFusion Agent" Application's OAuth credentials (FusionAuth admin ->
# Applications -> InFusion Agent -> OAuth). This is the app the employee logs in
# to; client_id is also the JWT `aud` on their access token, and the custom
# tools:* scopes are defined on this Application.
FUSIONAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
FUSIONAUTH_CLIENT_SECRET=change-me

# The MCP tool server's OWN non-human identity, distinct from the user it acts
# for. In FusionAuth the client_credentials grant is ENTITY MANAGEMENT (a paid
# feature) — NOT an Application grant (Applications have no Client Credentials
# checkbox). So create an ENTITY named "InFusion Agent — MCP Tool Server" and use
# its Client Id + Client secret here. Leave these unset to run without the
# non-human-identity card (it degrades to an honest "not connected" state).
FUSIONAUTH_MCP_CLIENT_ID=00000000-0000-0000-0000-000000000000
FUSIONAUTH_MCP_CLIENT_SECRET=change-me

# The scope for the Entity's client_credentials token, naming a target entity and
# permission(s): target-entity:<entityId>:<permission>. The requesting entity
# needs a Grant on that target (the tool-server entity can target itself). Without
# this, FusionAuth rejects the grant and the card shows "not connected".
# FUSIONAUTH_MCP_SCOPE=target-entity:0b951ff0-aa0f-41e6-b497-b915c7f08c0a:tool_execution

# A FusionAuth API key (Settings -> API Keys). Used server-side for Two-Factor
# (step-up) and the optional /api/user directory lookup. Needs permission on:
#   POST /api/two-factor/status, POST /api/two-factor/start,
#   POST /api/two-factor/send,  POST /api/two-factor/login,
#   GET  /api/user            (directory lookups / consent checks)
FUSIONAUTH_API_KEY=change-me

# RefundBot also needs, on the same key:
#   POST/DELETE /api/entity/{id}/grant, GET /api/entity/grant/search
#                             (create + revoke the on-demand banking-api Grant)
#   GET  /api/system/token-exchange-audit-log/search and .../chain
#                             (the /admin audit-log panel)
#   GET  /api/system/version, GET /api/reactor
#                             (the live-vs-simulated mode probe)
#
# Optional: pin the tenant when your instance has more than one. Left unset for a
# single-tenant instance (the default tenant is used).
# FUSIONAUTH_TENANT_ID=

# --- App ---------------------------------------------------------------------

# Public base URL of THIS app. Used to build the OAuth redirect_uri
# (<APP_BASE_URL>/api/auth/callback), the same-origin redirect guards, and the
# URL the agent uses to reach its own MCP server (<APP_BASE_URL>/api/mcp).
APP_BASE_URL=http://localhost:3000

# Secret used to derive the AES key that encrypts the session cookie (jose
# EncryptJWT, dir + A256GCM). Any length works — it's SHA-256'd to 32 bytes.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# --- RefundBot: OAuth Token Exchange (RFC 8693, Enterprise, FusionAuth 1.70.0+) ---

# The orchestrator Entity ("RefundBot Orchestrator", with "Act as token exchange
# client" enabled). Leave its Client Id at FusionAuth's default (= the Entity Id): the
# same value is the exchanger's client_id AND the Entity Id the Grant + audit-log APIs
# take.
FUSIONAUTH_ORCHESTRATOR_ENTITY_ID=00000000-0000-0000-0000-000000000000
FUSIONAUTH_ORCHESTRATOR_ENTITY_SECRET=change-me

# The four service Entities. Each Client Id is the `audience` a hop's exchange targets.
# Standing Grants orchestrator -> the first three; NONE to banking-api (the app creates
# and deletes that one around each approved refund).
FUSIONAUTH_ORDER_HISTORY_ENTITY_ID=00000000-0000-0000-0000-000000000001
FUSIONAUTH_SCORING_ENTITY_ID=00000000-0000-0000-0000-000000000002
FUSIONAUTH_BUDGET_ENTITY_ID=00000000-0000-0000-0000-000000000003
FUSIONAUTH_BANKING_ENTITY_ID=00000000-0000-0000-0000-000000000004

# The standard-tier self-service floor, in cents. Default $100. At or under it, the
# customer's own out-of-band confirmation is enough; above it, a support employee is
# looped in — unless FusionAuth FGA says `account#auto_approve` (a trusted account
# under its cap). Who may approve is then Permify's store -> region cascade.
REFUND_APPROVAL_FLOOR_CENTS=10000

# Optional portability override. Unset = probe the instance: live on 1.70.0+ with a
# license, simulated if no instance is reachable or it can't do Token Exchange.
# REFUNDBOT_EXCHANGE_MODE=live

# Optional: enables POST /api/admin/reset-demo with `Authorization: Bearer <token>`, so
# the demo can be reset without logging in or restarting. Unset = admin session only.
# DEMO_RESET_TOKEN=

# --- Agent (optional) --------------------------------------------------------

# When set, RefundBot's planner becomes a real Claude tool-calling turn. When unset,
# it runs its deterministic scripted planner ("Scripted Agent" banner). The
# AUTHORIZATION behavior is identical either way — the auth layers never trust the planner.
# ANTHROPIC_API_KEY=

# --- FusionAuth FGA ------------------------------------------------------------

# REST base URL of the Permify server that answers RefundBot's relationship + attribute
# checks: order ownership (`order#request_refund`), the employee approval cascade
# (`store#approve_local` -> `region#approve_escalated`), and the customer trust tier
# (`account#auto_approve`). Run it locally with:
#   docker run -p 3476:3476 -p 3478:3478 \
#     -e PERMIFY_AUTHN_ENABLED=true -e PERMIFY_AUTHN_METHOD=preshared \
#     -e PERMIFY_AUTHN_PRESHARED_KEYS=change-me \
#     ghcr.io/permify/permify serve
# The app loads permify/schema.perm and seeds the demo accounts, orders, stores, and
# region at boot. With no server reachable, the same behaviors run on an in-memory
# resolver behind a "Demo fallback" banner. Permify is open source; running it needs no
# FusionAuth plan (Enterprise only adds support / FusionAuth-hosted provisioning).
PERMIFY_URL=http://localhost:3476

# Permify tenant id. The server ships with a pre-inserted `t1`.
PERMIFY_TENANT=t1

# Preshared key — must match PERMIFY_AUTHN_PRESHARED_KEYS on the server. Leave blank
# only for a server started without authn.
PERMIFY_TOKEN=

# Optional: how long to wait on a Permify call before falling back, in milliseconds.
# Defaults to 2500. After a failure the app answers from the fallback for 30s, then
# tries Permify again — so it goes live by itself once Permify is up.
PERMIFY_TIMEOUT_MS=2500

# Optional: set to false to stop the demo seeding of PEOPLE: a support employee's first
# store/region relation (from their Application Role) and a new customer's `delegate` on
# the shared household account. Seeding only ever runs for someone with no relations yet,
# so anything you change in /admin sticks either way.
INFUSIONAGENT_SEED_DEMO=true

# --- Roles -------------------------------------------------------------------

# The Application Role name that unlocks the /admin page. Defaults to "admin" if
# unset — set it to match whatever your FusionAuth application calls it.
# INFUSIONAGENT_ADMIN_ROLE=admin

# --- MCP ---------------------------------------------------------------------

# Ceiling for a round trip to the app's OWN MCP server (handshake + call), in ms.
# Defaults to 30000.
MCP_CALL_TIMEOUT_MS=30000
