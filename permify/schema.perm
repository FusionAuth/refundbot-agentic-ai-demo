// RefundBot — FusionAuth FGA schema.
//
// A Permify "entity" below is a node in this relationship graph. It is NOT a FusionAuth
// Entity (the orchestrator and the four service audiences RefundBot's Token Exchange
// works with). Token Exchange answers "may the orchestrator get a token for THIS
// SERVICE?"; this schema answers "may THIS PERSON act on THIS RESOURCE?".
//
// Three questions, each asked at request time by lib/fga.ts:
//
//   1. order#request_refund   — before hop 1. Does the customer hold `owner` or
//                               `delegate` on the account the order belongs to? A denial
//                               stops the refund before any token is exchanged.
//   2. store#approve_local,   — on /support/approvals. The approving employee's own store
//      then                     under the store's cap; failing that, the store's region
//      region#approve_escalated  under the region's (higher) cap. Two single-entity
//                               checks, each a relation plus a rule over that entity's
//                               OWN attribute — no cross-entity attribute reach.
//   3. account#auto_approve   — at the escalation decision. A `trusted` account under its
//                               cap skips employee review. The customer's out-of-band
//                               MFA confirmation is still required regardless.
//
// Load it with:   POST /v1/tenants/{tenant}/schemas/write   { "schema": "<this file>" }
// lib/fga.ts keeps an identical copy (REFUND_SCHEMA) and loads it at boot, along with
// the demo relations and attributes derived from lib/refund-data.ts. The fallback
// resolver `demoCheck` in lib/fga.ts encodes the same rules by hand — change all three
// together.
//
// Two details checked against a running Permify server:
//   - string literals in a rule must be SINGLE-quoted ('trusted');
//   - `context.data.refund_amount_cents` (a JSON number) compares cleanly against an
//     `integer` attribute.

entity user {}

entity account {
  // `owner` is the account holder; `delegate` is shared/family access — a second
  // person who may ask for refunds on the account's orders.
  relation owner @user
  relation delegate @user

  // "standard" | "trusted", and the auto-approval ceiling in cents.
  attribute tier string
  attribute cap_cents integer

  action request_refund = owner or delegate
  action auto_approve = request_refund and tier_is_trusted(tier) and can_approve_amount(cap_cents)
}

entity order {
  // The one structural fact about an order: which account it belongs to. The order's
  // permission reaches through it — no app-code traversal on the live path.
  relation account @account

  action request_refund = account.request_refund
}

entity region {
  relation director @user

  attribute cap_cents integer

  action approve_escalated = director and can_approve_amount(cap_cents)
}

entity store {
  relation region @region
  relation manager @user

  attribute cap_cents integer

  action approve_local = manager and can_approve_amount(cap_cents)
}

rule tier_is_trusted(tier string) {
  tier == 'trusted'
}

rule can_approve_amount(cap_cents integer) {
  context.data.refund_amount_cents <= cap_cents
}
